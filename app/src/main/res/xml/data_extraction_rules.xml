<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="vault_data.db" />
        <exclude domain="database" path="vault_data.db-wal" />
        <exclude domain="database" path="vault_data.db-shm" />
        <exclude domain="file" path="vault_media/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vault_data.db" />
        <exclude domain="file" path="vault_media/" />
    </device-transfer>
</data-extraction-rules>
